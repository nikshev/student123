# .env.example — скопіюй у .env і заповни. Сам .env у git НЕ комітиться (.gitignore).
# Секрети згенерує ./docker/init/init-secrets.sh (openssl/ssh-keygen), крім AI_TUTOR_LLM_API_KEY.

# --- Open edX hosts (local.openedx.io резолвиться в 127.0.0.1 без /etc/hosts) ---
LMS_HOST=local.openedx.io
CMS_HOST=studio.local.openedx.io
# Хостові порти (всередині контейнерів LMS/CMS завжди :8000).
# Змінюй, якщо порти зайняті (напр. іншим стеком на тому ж хості).
LMS_PORT=8010
CMS_PORT=8011

# --- Django / edx-platform ---
OPENEDX_SECRET_KEY=change-me-opendex-secret-key-64-hex-chars-min
UWSGI_WORKERS=2

# --- MySQL 8.4 (edx-platform) ---
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MYSQL_DATABASE=openedx
MYSQL_USER=openedx
MYSQL_PASSWORD=change-me-mysql-openedx

# --- JWT (LMS<->CMS SSO). Генерується init-secrets.sh, руками не чіпати ---
JWT_COMMON_SECRET_KEY=change-me-jwt-common-secret
JWT_PRIVATE_SIGNING_JWK_JSON={"kid":"openedx","kty":"RSA","e":"AQAB","n":"change-me","d":"change-me"}
JWT_PUBLIC_SIGNING_JWK_SET_JSON={"keys":[{"kid":"openedx","kty":"RSA","e":"AQAB","n":"change-me"}]}

# --- CMS OAuth (Studio SSO через LMS) ---
CMS_OAUTH2_SECRET=change-me-cms-oauth2-secret

# --- Admin (створюється edx-init) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- AI Tutor Service (наш плагін) ---
# Внутрішній URL сервісу в docker-мережі (за замовчуванням збігається з compose).
AI_TUTOR_SERVICE_URL=http://ai-tutor-service:8001
# Ключ провайдера LLM (Anthropic). ОБОВ'ЯЗКОВО вписати вручну, інакше /ask повертатиме 502.
AI_TUTOR_LLM_API_KEY=
# Спільний секрет XBlock<->Service (Bearer). Згенерує init-secrets.sh.
AI_TUTOR_SHARED_SECRET=change-me-ai-tutor-shared-secret

# --- Third Party Auth (Social Login) ---
# Отримай ключі/секрети у відповідних Developer Console.
# Якщо не потрібно — залиш порожніми.
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
SOCIAL_AUTH_FACEBOOK_KEY=
SOCIAL_AUTH_FACEBOOK_SECRET=
SOCIAL_AUTH_LINKEDIN_OAUTH2_KEY=
SOCIAL_AUTH_LINKEDIN_OAUTH2_SECRET=
SOCIAL_AUTH_APPLE_ID_CLIENT=
SOCIAL_AUTH_APPLE_ID_TEAM=
SOCIAL_AUTH_APPLE_ID_KEY=
SOCIAL_AUTH_APPLE_ID_SECRET=
SOCIAL_AUTH_AZUREAD_OAUTH2_KEY=
SOCIAL_AUTH_AZUREAD_OAUTH2_SECRET=
SOCIAL_AUTH_AZUREAD_OAUTH2_TENANT_ID=common
SOCIAL_AUTH_GITHUB_KEY=
SOCIAL_AUTH_GITHUB_SECRET=
