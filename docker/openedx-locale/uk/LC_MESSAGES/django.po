msgstr "Щоб змінити ці налаштування, перейдіть на сторінку {link_start}Налаштування іспитів із прокторингом{link_end}."

#: cms/templates/course_outline.html:171
#, python-brace-format
msgid "To update these settings go to the {link_start}Advanced Settings page{link_end}."
msgstr "Щоб змінити ці налаштування, перейдіть на сторінку {link_start}Розширені налаштування{link_end}."

#: cms/templates/course_outline.html:178
