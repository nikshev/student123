#: cms/templates/export.html:63
#, python-brace-format
msgid "You can export libraries and edit them outside of {studio_name}. The exported file is a .tar.gz file (that is, a .tar file compressed with GNU Zip) that contains the library structure and content. You can also re-import libraries that you've exported."
msgstr "Ви можете експортувати бібліотеки й редагувати їх поза {studio_name}. Експортований файл .tar.gz (архів .tar, стиснений GNU Zip) містить структуру та вміст бібліотеки. Експортовані бібліотеки можна імпортувати повторно."

#: cms/templates/export.html:68
msgid "About Exporting Courses"
msgstr "Про експорт курсів"

#: cms/templates/export.html:71
#, python-brace-format
msgid "You can export courses and edit them outside of {studio_name}. The exported file is a .tar.gz file (that is, a .tar file compressed with GNU Zip) that contains the course structure and content. You can also re-import courses that you've exported."
msgstr "Ви можете експортувати курси й редагувати їх поза {studio_name}. Експортований файл .tar.gz (архів .tar, стиснений GNU Zip) містить структуру та вміст курсу. Експортовані курси можна імпортувати повторно."

#: cms/templates/export.html:74
#, python-brace-format
msgid "{em_start}Caution:{em_end} When you export a course, information such as MATLAB API keys, LTI passports, annotation secret token strings, and annotation storage URLs are included in the exported data. If you share your exported files, you may also be sharing sensitive or license-specific information."
msgstr "{em_start}Увага:{em_end} до експорту курсу входять такі дані, як ключі API MATLAB, паспорти LTI, секретні токени анотацій і URL-адреси сховища анотацій. Якщо ви поділитеся експортованими файлами, разом із ними можуть поширитися конфіденційні дані або відомості, обмежені ліцензією."

